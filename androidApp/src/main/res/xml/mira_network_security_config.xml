<?xml version="1.0" encoding="utf-8"?>
<!-- Permits cleartext HTTP only to local development backends. Production
     builds must use HTTPS and leave usesCleartextTraffic=false. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
